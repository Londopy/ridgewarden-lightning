[Unit]
Description=ridgewarden-lightning, lightning location for AREDN meshes
Documentation=https://github.com/Londopy/ridgewarden-lightning
After=network-online.target ridgewarden.service
Wants=network-online.target

[Service]
# its own user, in the core's group: it can read the core's local.token, not its station key
User=ridgewarden-lightning
Group=ridgewarden-lightning
SupplementaryGroups=ridgewarden
ExecStart=/usr/bin/ridgewarden-lightning --config /etc/ridgewarden/lightning.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ridgewarden-lightning

[Install]
WantedBy=multi-user.target
